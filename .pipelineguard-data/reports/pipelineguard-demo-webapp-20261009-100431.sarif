{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "PipelineGuard",
          "version": "1.0.0",
          "rules": [
            {
              "id": "slack-token",
              "name": "Slack token"
            },
            {
              "id": "aws-access-key",
              "name": "AWS access key"
            },
            {
              "id": "generic-secret-assignment",
              "name": "Generic secret assignment"
            },
            {
              "id": "private-key",
              "name": "Private key"
            },
            {
              "id": "malformed-dependency-manifest",
              "name": "Malformed dependency manifest"
            },
            {
              "id": "dependency-check-incomplete",
              "name": "Dependency check incomplete"
            },
            {
              "id": "known-dependency-vulnerability",
              "name": "Known dependency vulnerability"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "slack-token",
          "level": "error",
          "message": {
            "text": "Slack token detected."
          },
          "locations": [
